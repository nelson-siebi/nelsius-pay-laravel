{
    "name": "nelsius/nelsius-pay-laravel",
    "description": "The official Laravel package and Service Provider for Nelsius Pay API V2",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nelsius",
        "nelsiuspay",
        "laravel",
        "payments",
        "checkout",
        "mobile-money",
        "orange-money",
        "mtn-momo",
        "cameroon",
        "africa"
    ],
    "homepage": "https://nelsiuspay.com",
    "authors": [
        {
            "name": "Nelson Siebi",
            "email": "nelsonsiebi237@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "nelsius/nelsius-pay-php": "^2.0",
        "illuminate/support": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nelsius\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nelsius\\Laravel\\NelsiusServiceProvider"
            ],
            "aliases": {
                "Nelsius": "Nelsius\\Laravel\\Facades\\Nelsius"
            }
        }
    }
}